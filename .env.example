APP_ENV=development
APP_NAME=AI Automated Code Compliance Checking System
API_V1_PREFIX=/api/v1
API_CORS_ORIGINS=["http://localhost:5173"]

POSTGRES_DB=code_compliance
POSTGRES_USER=code_compliance
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://code_compliance:change-me@postgres:5432/code_compliance

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

MINIO_ROOT_USER=code-compliance
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=code-compliance
MINIO_SECRET_KEY=change-me-minio-password
MINIO_BUCKET=code-compliance
MINIO_SECURE=false

VITE_API_BASE_URL=http://localhost:8000/api/v1
